PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# MongoDB local ou string do Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/recipenator
# TheMealDB: a chave gratuita é "1" (desenvolvimento/estudo)
THEMEALDB_KEY=1
# Segredo dos tokens de login. Gere um valor próprio (não reutilize nem publique):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Fotos reais para as receitas da casa (opcional): chave gratuita em pexels.com/api. Usada por `npm run photos`.
PEXELS_API_KEY=

# Upload de fotos das receitas (opcional). Crie uma conta gratuita em cloudinary.com e copie os dados do painel.
# Deixe em branco para manter o upload desligado.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
